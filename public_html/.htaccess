php_value memory_limit "512M"
php_value max_execution_time 300

# Сессии — в свою папку, вне общего /var/tmp. Там 684 тысячи файлов
# сессий всех клиентов машины: содержимое закрыто правами 0600, но имена
# файлов видны всем, а имя файла и есть идентификатор сессии — весь
# секрет целиком. Дневник пускает по сессии (Auth::getOwnerId сначала
# смотрит $_SESSION), поэтому чужой взгляд на список файлов равен ключу.
# Здесь, а не в .user.ini: PHP на площадке — модуль Apache, .user.ini
# читают только CGI и FPM, и там эти строки молча ничего не делали.
php_value session.save_path "/home/i/infopolura/sessions"

# Идентификатор сессии назначает сервер, а не клиент.
php_flag session.use_strict_mode on

# Cookie сессии — только по https и только серверу. Secure стало можно
# после редиректа выше: до него флаг отрезал бы тех, кто пришёл по http.
php_flag session.cookie_secure on
php_flag session.cookie_httponly on
php_value session.cookie_samesite "Lax"

Options -Indexes
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
	Options +FollowSymLinks
	RewriteEngine On
	# Весь сайт по https. nginx терминирует TLS и ходит в Apache обычным
	# http, поэтому %{HTTPS} здесь всегда пуст, а REQUEST_SCHEME всегда
	# http: проверять их значило бы зациклить редирект. Честный признак
	# один — заголовок от прокси.
	RewriteCond %{HTTP:X-Forwarded-Proto} !=https
	RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
	# Установщик Bitrix и отладочные скрипты уже приезжали в корень с
	# восстановлением из архива 27.06.2026: bitrixsetup.php — это чужой путь
	# записи на сервер, test-скрипты печатают имя БД. Вернутся — мёртвыми.
	RewriteRule ^(bitrixsetup|test|check_tables|check_encoding|bitrix_test|enum_test)\.php$ - [F]
	# Дневник, открытый по ссылке: /d/<токен> — та же главная, только с
	# токеном. Ровно 32 знака шестнадцатеричных: короче или длиннее — не наш
	# адрес, и пусть отвечает обычной 404-й.
	RewriteRule ^d/([0-9a-f]{32})$ /index.php?d=$1 [L,QSA]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-l
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME} !/bitrix/urlrewrite.php$
	RewriteRule ^(.*)$ /bitrix/urlrewrite.php [L]
	RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_dir.c>
	DirectoryIndex index.php index.html
</IfModule>

<IfModule mod_negotiation.c>
	Options -MultiViews
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive on
	ExpiresByType image/jpeg "access plus 3 day"
	ExpiresByType image/gif "access plus 3 day"
	ExpiresByType image/png "access plus 3 day"
	ExpiresByType text/css "access plus 3 day"
	ExpiresByType application/javascript "access plus 3 day"
</IfModule>

# Новый сервис-воркер должен подхватываться сразу, а не через трое суток
# ExpiresByType выше. Без mod_headers деградация мягкая: браузер и сам
# сверяет sw.js не реже раза в сутки.
<IfModule mod_headers.c>
	<Files "sw.js">
		Header set Cache-Control "no-cache"
	</Files>
</IfModule>
