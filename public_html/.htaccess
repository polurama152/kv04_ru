php_value memory_limit "512M"
php_value max_execution_time 300

Options -Indexes
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
	Options +FollowSymLinks
	RewriteEngine On
	# Установщик Bitrix и отладочные скрипты уже приезжали в корень с
	# восстановлением из архива 27.06.2026: bitrixsetup.php — это чужой путь
	# записи на сервер, test-скрипты печатают имя БД. Вернутся — мёртвыми.
	RewriteRule ^(bitrixsetup|test|check_tables|check_encoding|bitrix_test|enum_test)\.php$ - [F]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-l
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_FILENAME} !/bitrix/urlrewrite.php$
	RewriteRule ^(.*)$ /bitrix/urlrewrite.php [L]
	RewriteRule .* - [E=REMOTE_USER:%{HTTP:Authorization}]
</IfModule>

<IfModule mod_dir.c>
	DirectoryIndex index.php index.html
</IfModule>

<IfModule mod_negotiation.c>
	Options -MultiViews
</IfModule>

<IfModule mod_expires.c>
	ExpiresActive on
	ExpiresByType image/jpeg "access plus 3 day"
	ExpiresByType image/gif "access plus 3 day"
	ExpiresByType image/png "access plus 3 day"
	ExpiresByType text/css "access plus 3 day"
	ExpiresByType application/javascript "access plus 3 day"
</IfModule>
